<mujoco model="zarm_realhand_l6_right_arena">
	<compiler angle="radian" autolimits="true" eulerseq="XYZ" />
	<option integrator="implicitfast" impratio="10" cone="elliptic" noslip_iterations="2" />

	<default>
		<!-- RealHand L6 Right -->
		<default class="l6_right">
			<joint damping="1.0" armature="0.01" />
		</default>
		<default class="l6_right_visual">
			<geom contype="0" conaffinity="0" group="2" material="l6_right_visual_material" />
		</default>
		<default class="l6_right_collision">
			<!-- PEEK material has a friction coefficient of ~mu=0.35, but setting the first component of friction in the geom below to 0.3 caused simulation instability issues. We thus set mu=1.0 and varied the object friction per regime.

			Since MuJoCo combines friction as sqrt(mu_finger * mu_object) geometric mean,
			friction variability in our simulation experiments thus came solely from the manipuland and not the hand's fingertips.
			-->
			<geom contype="1"
			      conaffinity="1"
			      condim="4"
			      group="1"
			      friction="1.0 0.002 0.0001"
			      material="l6_right_collision_material" />
		</default>

		<!-- ZArm -->
		<default class="zarm">
			<material specular="0.5" shininess="0.25" />
			<joint axis="0 1 0" range="-3.0543 3.0543"  damping="1.0" armature="0.1"/>
			<general gaintype="fixed"
			         biastype="affine"
					 ctrlrange="-3.0543 3.0543"
			         gainprm="3000"
			         biasprm="0 -3000 -850"
			         forcerange="-600 600" />
			<site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4" />
		</default>
		<default class="size3">
			<general gaintype="fixed"
			         biastype="affine"
			         ctrlrange="-3.0543 3.0543"
			         gainprm="3000"
			         biasprm="0 -3000 -850"
			         forcerange="-600 600" />
		</default>
		<default class="size2">
			<general gaintype="fixed"
			         biastype="affine"
			         ctrlrange="-4.6251 1.4835"
			         gainprm="3000"
			         biasprm="0 -3000 -850"
			         forcerange="-600 600" />
		</default>
		<default class="size3_limited">
			<general gaintype="fixed"
			         biastype="affine"
			         ctrlrange="-2.8274 2.8274"
			         gainprm="3000"
			         biasprm="0 -3000 -850"
			         forcerange="-600 600" />
		</default>
		<default class="size1">
			<general gaintype="fixed"
			         biastype="affine"
			         ctrlrange="-3.0543 3.0543"
			         gainprm="1200"
			         biasprm="0 -1200 -500"
			         forcerange="-50 50" />
		</default>
		<default class="visual">
			<geom type="mesh" contype="0" conaffinity="0" group="2" />
		</default>
		<default class="collision">
			<geom type="mesh" group="3" />
		</default>
		<default class="eef_collision">
			<geom type="cylinder" group="3" />
		</default>

		<default class="realhand_l6_right">
			<joint armature="0.01" damping=".1" solreflimit="4e-3 1" solimplimit=".95 .99 1e-3"/>
		</default>

		<!-- D435i -->
		<default class="d435i">
			<material specular="0" shininess="0.25" />
		</default>
		<default class="d435i_visual">
			<geom group="2"
			      type="mesh"
			      contype="0"
			      conaffinity="0"
			      mass="0" />
		</default>

		<!-- Astra -->
		<default class="astra">
			<material specular="0" shininess="0.25" />
		</default>
		<default class="astra_visual">
			<geom group="2" type="mesh" contype="0" conaffinity="0" />
		</default>
		<default class="astra_collision">
			<geom material="astra_collision_material"
			      condim="3"
			      contype="0"
			      conaffinity="1"
			      priority="1"
			      group="1"
			      solref="0.005 1"
			      solimp="0.99 0.999 1e-05"
			      friction="1 0.01 0.01"
			      mass="0.31" />
		</default>
	</default>

