		<exclude body1="camera_depth_frame" body2="camera_color_frame" />
		<exclude body1="camera_color_frame" body2="camera_color_optical_frame" />
		<exclude body1="camera_link" body2="camera_depth_frame" />
		<exclude body1="camera_depth_frame" body2="camera_depth_optical_frame" />

		<!-- collision filtering -->
		<!-- Robot base link and adjacent links -->
		<exclude body1="base_link" body2="table" />
		<exclude body1="base_link" body2="shoulder_link" />
    	<!-- filter the palm from the base of the thumb -->
    	<!-- Note that the metacarpals of the thumb must not touch or collide with any of the other four finger links-->
    	<!-- Since the non-thumb fingers cannot yaw, this leaves the thumb and index as the only two fingers to check for. -->
	    <exclude body1="hand_base" body2="thumb_metacarpals_base2" />
	    <exclude body1="hand_base" body2="thumb_metacarpals" />

	    <!-- Tables -->
	    <exclude body1="workspace_table" body2="table" />
