<!--
Generic ISO 9409-1-50-4-M6 standard flange wrist RealSense camera adapter + wrist-mounted D435i.

This file is a *body-contents fragment* intended to be included inside:
  <body name="realsense_camera_adapter_link"> ... </body>

It intentionally does NOT include the standoffs or any gripper-specific mount hardware.
It also assumes the including model defines the D435i assets/defaults (materials, meshes, and
class "d435i" / "d435i_visual").
-->

<mujoco model="ur5_realsense_adapter_wrist_d435i_contents">

<inertial pos="0 0 0" mass="1.0" diaginertia="0.001 0.001 0.001" />
<geom
  name="realsense_adapter_visual_0"
  quat="1.0 0.0 0.0 0.0"
  type="mesh"
  mesh="picknik_ur5_realsense_camera_adapter_rev2_visual"
  contype="0"
  conaffinity="0"
  group="2"
  rgba="1 1 1 1"
/>

<!-- Wrist camera (D435i body instance) -->
<body name="wrist_d435i" pos="0 -0.0575 0.0495" quat="0 0 0.2955 0.9553" childclass="d435i">
  <camera name="wrist_camera" pos="0 0 0" quat="0 0 -1 0" fovy="75" resolution="640 480" />
  <geom mesh="d435i_0" material="IR_Lens" class="d435i_visual"/>
  <geom mesh="d435i_1" material="IR_Emitter_Lens" class="d435i_visual"/>
  <geom mesh="d435i_2" material="IR_Rim" class="d435i_visual"/>
  <geom mesh="d435i_3" material="IR_Lens" class="d435i_visual"/>
  <geom mesh="d435i_4" material="Cameras_Gray" class="d435i_visual"/>
  <geom mesh="d435i_5" material="Black_Acrylic" class="d435i_visual"/>
  <geom mesh="d435i_6" material="Black_Acrylic" class="d435i_visual"/>
  <geom mesh="d435i_7" material="RGB_Pupil" class="d435i_visual"/>
  <geom mesh="d435i_8" mass="0.072" material="Metal_Casing" class="d435i_visual"/>

  <!-- Simple collision proxy for the camera body -->
  <geom name="d435i_collision"
        type="box"
        size="0.025 0.018 0.012"
        pos="0 0 0"
        quat="1 0 0 0"
        rgba="0 0 0 0"
        contype="1"
        conaffinity="1"
        condim="3"
        friction="0.7 0.01 0.001"
        group="3" />
</body>

</mujoco>
