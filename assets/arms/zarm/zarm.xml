<mujoco model="zarm">  
  <compiler angle="radian" autolimits="true" />
  <option integrator="implicitfast"/>
  <default>
    <!-- Keep common joint/actuator defaults at the top-level so robosuite can parse them -->
    <joint armature="0.1"/>
    <general gaintype="fixed" biastype="affine" gainprm="2000" biasprm="0 -2000 -400" forcerange="-150 150"/>

    <!-- Joint-specific classes (flattened; robosuite's parser may not pick up nested <default> blocks) -->
    <default class="zarm_j1">
      <joint range="-3.0543 3.0543" />
      <general ctrlrange="-3.0543 3.0543" forcerange="-150 150" />
    </default>
    <default class="zarm_j2">
      <joint range="-4.6251 1.4835" />
      <general ctrlrange="-4.6251 1.4835" forcerange="-150 150" />
    </default>
    <default class="zarm_j3">
      <joint range="-2.8274 2.8274" />
      <general ctrlrange="-2.8274 2.8274" forcerange="-150 150" />
    </default>
    <default class="zarm_j4">
      <joint range="-4.6251 1.4835" />
      <general ctrlrange="-4.6251 1.4835" gainprm="500" biasprm="0 -500 -100" forcerange="-28 28" />
    </default>
    <default class="zarm_j5">
      <joint range="-3.0543 3.0543" />
      <general ctrlrange="-3.0543 3.0543" gainprm="500" biasprm="0 -500 -100" forcerange="-28 28" />
    </default>
    <default class="zarm_j6">
      <joint range="-3.0543 3.0543" />
      <general ctrlrange="-3.0543 3.0543" gainprm="500" biasprm="0 -500 -100" forcerange="-28 28" />
    </default>

    <default class="visual">
      <geom contype="0" conaffinity="0" group="2" material="visualgeom" />
    </default>
    <default class="collision">
      <geom contype="1" conaffinity="1" condim="4" group="1" material="collision_material" />
    </default>
  </default>

  <asset>
    <material name="visualgeom" rgba="1 1 1 1" specular="0.5" shininess="0.25"/>
    <material name="collision_material" rgba="0 0 0 0" />
    <texture name="texplane" type="2d" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" width="100" height="100" />
    <material name="matplane" texture="texplane" texrepeat="1 1" texuniform="true" />
    <mesh name="base_link" file="meshes/base_link.STL" />
    <mesh name="shoulder_link" file="meshes/shoulder_link.STL" />
    <mesh name="upperarm_link" file="meshes/upperarm_link.STL" />
    <mesh name="forearm_link" file="meshes/forearm_link.STL" />
    <mesh name="wrist1_link" file="meshes/wrist1_link.STL" />
    <mesh name="wrist2_link" file="meshes/wrist2_link.STL" />
    <mesh name="wrist3_link" file="meshes/wrist3_link.STL" />
    <mesh name="base_link_visual" file="meshes/base_link.obj" />
    <mesh name="shoulder_link_visual" file="meshes/shoulder_link.obj" />
    <mesh name="upperarm_link_visual" file="meshes/upperarm_link.obj" />
    <mesh name="forearm_link_visual" file="meshes/forearm_link.obj" />
    <mesh name="wrist1_link_visual" file="meshes/wrist1_link.obj" />
    <mesh name="wrist2_link_visual" file="meshes/wrist2_link.obj" />
    <mesh name="wrist3_link_visual" file="meshes/wrist3_link.obj" />
  </asset>
  <worldbody>
    <body name="root" pos="0 0 0.0">
      <inertial pos="-0.00049027 -0.00045095 0.032527" mass="0.78393" diaginertia="0.0013854 0.0013849 0.001977" />
      <body name="shoulder_link">
        <inertial pos="-3.8658e-07 -0.0024176 0.13519" quat="0.99894 0.046032 1.3278e-05 -3.93343e-05" mass="2.1225" diaginertia="0.0033227 0.0032419 0.0023129" />
        <joint name="shoulder_pan_joint" class="zarm_j1" pos="0 0 0" axis="0 0 1"  />
        <geom name="shoulder_link_collision_0" type="mesh" rgba="0 0 0 0" mesh="shoulder_link" class="collision" />
        <body name="upperarm_link" pos="0 0 0.14" quat="0.707105 0.707108 0 0">
          <inertial pos="-0.14111 3.4656e-06 0.11053" quat="0.49815 0.501844 0.501844 0.49815" mass="4.8053" diaginertia="0.0081317 0.0059231 0.0075945" />
          <joint name="shoulder_lift_joint" class="zarm_j2" pos="0 0 0" axis="0 0 1"  />
          <geom name="upperarm_link_collision_0" type="mesh" rgba="0 0 0 0" mesh="upperarm_link" class="collision" />
          <body name="forearm_link" pos="-0.28 0 0">
            <inertial pos="-0.18987 5.2268e-06 0.0034145" quat="0.505712 0.494222 0.494276 0.505659" mass="2.2312" diaginertia="0.0035145 0.0029186 0.0028852" />
            <joint name="elbow_joint" class="zarm_j3" pos="0 0 0" axis="0 0 1"  />
            <geom name="forearm_link_collision_0" type="mesh" rgba="0 0 0 0" mesh="forearm_link" class="collision" />
            <body name="wrist1_link" pos="-0.24001 0 0">
              <inertial pos="4.5665e-07 -0.0034666 0.098292" quat="0.728043 0.685531 -0.000124687 0.000140596" mass="1.5961" diaginertia="0.0020112 0.0019076 0.0014524" />
              <joint name="wrist_1_joint" class="zarm_j4" pos="0 0 0" axis="0 0 1"  />
              <geom name="wrist1_link_collision_0" type="mesh" rgba="0 0 0 0" mesh="wrist1_link" class="collision" />
              <body name="wrist2_link" pos="0 0 0.102" quat="0.707105 0.707108 0 0">
                <inertial pos="-4.5262e-07 0.0034666 0.098292" quat="0.685531 0.728043 0.000140596 -0.000124687" mass="1.5961" diaginertia="0.0020112 0.0019076 0.0014524" />
                <joint name="wrist_2_joint" class="zarm_j5" pos="0 0 0" axis="0 0 1"  />
                <geom name="wrist2_link_collision_0" type="mesh" rgba="0 0 0 0" mesh="wrist2_link" class="collision" />
                <body name="wrist3_link" pos="0 0 0.102" quat="0.707105 -0.707108 0 0">
                  <inertial pos="7.559e-05 1.3858e-05 0.076619" quat="0.000863331 0.707146 0.000390787 0.707067" mass="0.53877" diaginertia="0.00042655 0.00028896 0.00028785" />
                  <joint name="wrist_3_joint" class="zarm_j6" pos="0 0 0" axis="0 0 1"  />
                  <geom name="wrist3_link_collision_0" type="mesh" rgba="0 0 0 0" mesh="wrist3_link" class="collision" />
                  <geom class="visual" name="wrist3_link_visual_0" quat="1.0 0.0 0.0 0.0" rgba="0.89804 0.91765 0.92941 1" type="mesh" mesh="wrist3_link_visual" />

                  <!-- robosuite-compatible attachment frame and wrist camera -->
                  <site name="attachment_site" pos="0 0 0.1" quat="-1 1 0 0"/>
                  <site name="right_center" pos="0 0 0.1" quat="-1 1 0 0"/>
                  <camera name="wrist_camera" pos="0 0.05 0.02" quat="1 0 0 0" fovy="58" mode="fixed"/>

                  <!-- robosuite expects this body as the gripper eef frame -->
                  <body name="right_hand" pos="0 0 0.098" quat="0.707 -0.707 0 0"/>

                  <!-- Dummy tool0 to match URDF semantics; no geom -->
                  <body name="tool0" pos="0 0 0.1" euler="-1.5707963267948966 0 0"/>
                </body>
                <geom class="visual" name="wrist2_link_visual_0" quat="1.0 0.0 0.0 0.0" rgba="0.89804 0.91765 0.92941 1" type="mesh" mesh="wrist2_link_visual" />
              </body>
              <geom class="visual" name="wrist1_link_visual_0" quat="1.0 0.0 0.0 0.0" rgba="0.89804 0.91765 0.92941 1" type="mesh" mesh="wrist1_link_visual" />
            </body>
            <geom class="visual" name="forearm_link_visual_0" quat="1.0 0.0 0.0 0.0" rgba="0.89804 0.91765 0.92941 1" type="mesh" mesh="forearm_link_visual" />
          </body>
          <geom class="visual" name="upperarm_link_visual_0" quat="1.0 0.0 0.0 0.0" rgba="0.89804 0.91765 0.92941 1" type="mesh" mesh="upperarm_link_visual" />
        </body>
        <geom class="visual" name="shoulder_link_visual_0" quat="1.0 0.0 0.0 0.0" rgba="0.89804 0.91765 0.92941 1" type="mesh" mesh="shoulder_link_visual" />
      </body>
      <geom class="visual" name="root_visual_0" quat="1.0 0.0 0.0 0.0" rgba="0.89804 0.91765 0.92941 1" type="mesh" mesh="base_link_visual" />
    </body>
  </worldbody>

  <actuator>
    <general name="shoulder_pan" joint="shoulder_pan_joint" class="zarm_j1" />
    <general name="shoulder_lift" joint="shoulder_lift_joint" class="zarm_j2" />
    <general name="elbow" joint="elbow_joint" class="zarm_j3" />
    <general name="wrist_1" joint="wrist_1_joint" class="zarm_j4" />
    <general name="wrist_2" joint="wrist_2_joint" class="zarm_j5" />
    <general name="wrist_3" joint="wrist_3_joint" class="zarm_j6" />
  </actuator>
</mujoco>